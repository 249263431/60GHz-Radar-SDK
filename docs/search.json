---
layout: null
permalink: /search.json
---
[
{% assign pages = site.pages | where_exp: "p", "p.title != nil" %}
{% assign all = pages | concat: site.posts %}
{% for doc in all %}
  {
    "title": {{ doc.title | jsonify }},
    "url": {{ doc.url | relative_url | jsonify }},
    "content": {{ doc.excerpt | default: doc.content | strip_html | strip_newlines | truncate: 240 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
